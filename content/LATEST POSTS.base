properties:
  file.name:
    displayName: Post
  file.ctime:
    displayName: Creation Date
views:
  - type: table
    name: Latest Posts
    filters:
      and:
        - file.tags.contains("post")
    order:
      - file.name
      - file.ctime
      - Summary
    sort:
      - property: Summary
        direction: ASC
      - property: file.ctime
        direction: DESC
    limit: 10
