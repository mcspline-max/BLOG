properties:
  file.name:
    displayName: Post
  file.ctime:
    displayName: Creation Date
views:
  - type: cards
    name: Latest Posts
    filters:
      and:
        - file.tags.contains("post")
        - draft != true
    order:
      - file.name
      - file.ctime
      - Summary
    sort:
      - property: file.ctime
        direction: DESC
    image: note.image_cover
    imageAspectRatio: 0.95
    cardSize: 190
