properties:
  file.name:
    displayName: Post
  file.ctime:
    displayName: Creation Date
views:
  - type: list
    name: Latest Posts
    filters:
      and:
        - file.tags.contains("post")
        - draft != false
    order:
      - file.name
      - file.ctime
      - Summary
    sort:
      - property: file.ctime
        direction: DESC
    limit: 10
    image: note.image_cover
    imageAspectRatio: 0.9
    cardSize: 220
